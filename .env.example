# ----------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ----------------------------------------------------------------------

# --- OpenRouter (LLM access) ---
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# OpenRouter exposes an OpenAI-compatible endpoint:
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free-tier model on OpenRouter. OpenRouter's free-model lineup changes
# over time (old slugs get deprecated/paywalled) - if this one 404s, check
# https://openrouter.ai/models?max_price=0 for a current replacement.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional headers OpenRouter uses for attribution (safe to leave as-is):
OPENROUTER_APP_NAME=movie-text-to-sql
OPENROUTER_SITE_URL=http://localhost:8501

# --- PostgreSQL ---
POSTGRES_USER=movies
POSTGRES_PASSWORD=movies
POSTGRES_DB=moviesdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy URL (built from the parts above; override if needed):
DATABASE_URL=postgresql+psycopg2://movies:movies@localhost:5432/moviesdb

# --- Agent behaviour ---
MAX_SQL_REPAIR_RETRIES=3
